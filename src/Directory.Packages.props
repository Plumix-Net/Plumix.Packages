<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Minimum Plumix version the packages are built and tested against; it becomes the
         lower bound of the Plumix dependency in every nuspec. Raise it together with any
         Plumix release that breaks binary compatibility.
         CI overrides it with -p:PlumixVersion=... to re-test against the packed dependency. -->
    <PlumixVersion Condition="'$(PlumixVersion)' == ''">1.0.0-preview.1</PlumixVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Plumix" Version="$(PlumixVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <!-- Android bindings of the platform plugins -->
    <PackageVersion Include="Xamarin.AndroidX.Credentials" Version="1.6.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" Version="1.6.0.2" />
    <PackageVersion Include="Xamarin.GoogleAndroid.Libraries.Identity.GoogleId" Version="1.1.0.13" />
    <PackageVersion Include="Xamarin.Android.Google.BillingClient" Version="9.1.0.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
