<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Plumix.Bloc</PackageId>
    <!-- Versioned after the flutter_bloc pub package it ports (Versions.props). -->
    <Version>$(PlumixBlocVersion)</Version>
    <Description>A port of Flutter's flutter_bloc package for Plumix: BlocProvider, BlocBuilder, BlocListener, BlocConsumer, BlocSelector and RepositoryProvider. Brings Plumix.Bloc.Core (Cubit, Bloc) with it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plumix.Bloc.Core\Plumix.Bloc.Core.csproj" />
  </ItemGroup>

</Project>
